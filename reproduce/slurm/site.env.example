# Site settings for the Slurm path. Copy to reproduce/slurm/site.env (git-ignored) and edit;
# every variable can also be given in the environment. Values in comments are the ones the paper used.
export SLURM_PARTITION=                   # e.g. compute-hf   (2x Xeon Gold 6444Y, 32 cores, 503 GB)
export SLURM_MEM=                         # e.g. 490G        (per-job memory; MNIST RF COPSE peaks at 96 GB)
export SLURM_EXTRA_ARGS=""                # e.g. "--account=myproj --mail-type=END,FAIL --mail-user=me@example.org"
export CORE_ENV=1mm-core                  # conda env created by environment/setup_env.sh
# export CONDA_BASE=$HOME/miniconda3      # only if `conda` is not on PATH inside batch jobs
# export TMPDIR=$HOME/tmp                 # if the compute nodes' /tmp is small (OpenFHE writes temporaries)
